<div class="container mt-4">
  <p class="text-success"><%= notice %></p>

  <div class="card mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start mb-4">
        <h1 class="card-title mb-0"><%= @task.title %></h1>
        <span class="badge bg-<%= @task.completed? ? 'success' : 'secondary' %> align-self-center">
          <%= @task.completed? ? 'Completed' : 'Pending' %>
        </span>
      </div>
      
      <% if @task.description.present? %>
        <div class="mb-4">
          <h5 class="text-muted">Description</h5>
          <p class="card-text"><%= simple_format(@task.description) %></p>
        </div>
      <% end %>
    </div>
  </div>


  <div class="d-flex gap-2">
    <div class="btn-group" role="group">
      <%= link_to "Edit Task", edit_list_task_path(@task.list, @task), class: "btn btn-outline-primary" %>
      <%= link_to "Back to Tasks", list_tasks_path(@task.list), class: "btn btn-outline-secondary" %>
    </div>
    
    <div class="ms-auto">
      <%= button_to "Delete Task", [@task.list, @task], 
          method: :delete, 
          form: { class: "d-inline" },
          data: { turbo_confirm: 'Are you sure you want to delete this task?' }, 
          class: "btn btn-outline-danger" %>
    </div>
  </div>
</div>
