<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>New Task for <%= @list.title %></h1>
    <%= link_to "Back to List", list_path(@list), class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <div class="card-body">
      <%= render "form", task: @task %>
    </div>
  </div>
</div>
