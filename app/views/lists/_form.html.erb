<%= form_with(model: list, class: "needs-validation", html: { novalidate: true }) do |form| %>
  <% if list.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
      <h5 class="alert-heading"><%= pluralize(list.errors.count, "error") %> prohibited this list from being saved:</h5>
      <ul class="mb-0">
        <% list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label fw-bold" %>
    <%= form.text_field :title, class: "form-control", required: true %>
    <div class="invalid-feedback">
      Please provide a title for the list.
    </div>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "form-label fw-bold" %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="d-flex justify-content-end">
    <div class="btn-group" role="group">
      <%= link_to "Cancel", lists_path, class: "btn btn-outline-secondary" %>
      <%= form.submit class: "btn btn-outline-primary" %>
    </div>
  </div>
<% end %>
