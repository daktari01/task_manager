<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><%= @list.title %></h1>
    <div class="btn-group" role="group">
      <%= link_to "Edit", edit_list_path(@list), class: "btn btn-outline-primary" %>
      <%= link_to "Back to Lists", lists_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Add Task", new_list_task_path(@list), class: "btn btn-success" %>
    </div>
  </div>

  <div class="card border-primary mb-4">
    <div class="card-body">
      <% if @list.description.present? %>
        <div class="mb-3">
          <h5 class="text-muted">Description</h5>
          <p class="card-text"><%= simple_format(@list.description) %></p>
        </div>
      <% end %>
      
      <div class="mb-2">
        <span class="text-muted">Created:</span>
        <span class="ms-2"><%= time_ago_in_words(@list.created_at) %> ago</span>
      </div>
      
      <% if @list.updated_at != @list.created_at %>
        <div class="mb-2">
          <span class="text-muted">Last updated:</span>
          <span class="ms-2"><%= time_ago_in_words(@list.updated_at) %> ago</span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <div class="btn-group" role="group">
      <%= link_to "View Tasks", list_tasks_path(@list), class: "btn btn-outline-primary" %>
      <%= button_to "Delete List", @list, 
          method: :delete, 
          form: { class: "ms-2", data: { turbo_confirm: 'Are you sure you want to delete this list and all its tasks?' } }, 
          class: "btn btn-outline-danger" %>
    </div>
  </div>
</div>
