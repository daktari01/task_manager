<p style="color: green"><%= notice %></p>

<%= render @list %>

<div>
  <%= link_to "Edit this list", edit_list_path(@list), class: "btn btn-primary me-3" %>
  <%= link_to "Back to lists", lists_path, class: "btn btn-primary" %>

  <%= button_to "Destroy this list", @list, method: :delete, class: "btn btn-danger mt-3" %>
</div>
